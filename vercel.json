{
  "buildCommand": "node fetch-assets.mjs",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/analyze-face", "destination": "/api/analyze-face" }
  ],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "model/gltf-binary" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
