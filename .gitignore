# 3D assets are NOT committed.
#
# Ready Player Me's animation-library licence, clause 3: "You may not
# redistribute, sell, or otherwise transfer the Animations, in whole or in
# part, to any third party." Committing them to a repo is redistribution.
#
# Run `node fetch-assets.mjs` to pull them from Ready Player Me's own repos.
#
# Hair meshes ARE committed, unlike everything else under models/ — they're
# CC0 (public domain), not RPM's restricted animation-library assets, so
# there's no redistribution problem. See index.html's hair-styles section
# for provenance (ported from the sibling character-customizer project).
# (models/* + a negation, not a bare models/ exclusion — git won't apply a
# negation to files inside a directory that's already excluded wholesale.)
models/*
!models/hair/
!models/headwear/
.env
# scratch renders
*.png
!contact-sheet.png
!models/headwear/*.png

node_modules


character-customizer